# Plugin-specific Claude instructions stay private
CLAUDE.local.md

# Scratch space (test data, agent output; not linked into the site)
/temp/

# mkp keeps enabled packages in local/share/check_mk, i.e. plugins_legacy/
/plugins_legacy/enabled_packages/

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# OS cruft
.DS_Store

# Built MKPs (.devcontainer/build.sh copies them here; CI attaches them to releases)
/*.mkp

# Development environment, not part of the plugin: kept locally, not in the repo
/.devcontainer/
/.github/
/pyproject.toml
/.flake8
/.claude/
/CLAUDE.md
/docs/superpowers/
/.superpowers/
